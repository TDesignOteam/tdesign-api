      "React(PC)",
      "Vue(Mobile)",
      "React(Mobile)"
    ],
    "component": "Image",
    "field_category": "Props",
    "field_name": "srcset",
    "field_type": [
      "Object"
    ],
    "field_desc_zh": "图片链接集合，用于支持特殊格式的图片，如 `.avif` 和 `.webp`。会优先加载 `srcset` 中的图片格式，浏览器不支持的情况下，加载 `src` 设置的图片地址",
    "field_desc_en": "for `.avif` and `.webp` image url, load `srcset` before `src`",
    "custom_field_type": "ImageSrcset【interface ImageSrcset { 'image/avif': string; 'image/webp': string; }】",
    "test_description": "{\"PC\":{\"attribute\":[{\"value\":\"{'image/avif': 'https://tdesign.gtimg.com/img/tdesign-image.avif','image/webp': 'https://tdesign.gtimg.com/img/tdesign-image.webp'}\",\"expect\":[{\"dom\":\"picture > source\",\"attribute\":{\"srcset\":\"https://tdesign.gtimg.com/img/tdesign-image.avif\"}},{\"dom\":\"picture > source:nth-child(2)\",\"attribute\":{\"srcset\":\"https://tdesign.gtimg.com/img/tdesign-image.webp\"}}]}]}}"
  },
