  {
    "id": 1823,
    "platform_framework": [
      "Vue(PC)",
      "React(PC)"
    ],
    "component": "Cascader",
    "field_category": "Props",
    "field_name": "collapsedItems",
    "field_type": [
      "TNode"
    ],
    "field_desc_zh": "多选情况下，用于设置折叠项内容，默认为 `+N`。如果需要悬浮就显示其他内容，可以使用 collapsedItems 自定义。`value` 表示当前存在的所有标签，`collapsedSelectedItems` 表示折叠的标签，`count` 表示折叠的数量，`onClose` 表示移除标签的事件回调",
    "custom_field_type": "TNode<{ value: CascaderOption[]; collapsedSelectedItems: CascaderOption[]; count: number; onClose: (context: { index: number, e?: MouseEvent }) => void }>"
  },
  {
    "id": 1778749788,
    "platform_framework": [
      "Vue(PC)",
      "React(PC)"
    ],
    "component": "Cascader",
    "field_category": "Props",
    "field_name": "columnFooter",
    "field_type": [
      "String",
      "TNode"
    ],
    "field_desc_zh": "每一列的底部自定义内容。`panelIndex` 表示当前列索引，`options` 表示当前列原始选项，`filteredOptions` 表示当前列过滤后的选项（未过滤时与 options 相同），`onFilter` 用于过滤当前列选项（传入字符串时内置大小写不敏感匹配；如需自定义匹配逻辑请传入过滤函数）。当内置搜索（filterable）有输入时，面板切换为扁平模式，`onFilter` 为空操作",
    "field_desc_en": "Custom content at the bottom of each column. `panelIndex` indicates the current column index, `options` is the original option list, `filteredOptions` is the filtered option list (same as `options` when no filter is applied), `onFilter` is used to filter the current column options (built-in case-insensitive matching for strings; pass a filter function for custom matching). When the built-in search (filterable) has input, the panel switches to flat mode and `onFilter` becomes a noop",
    "custom_field_type": "TNode<{ panelIndex: number; options: TreeOptionData[]; filteredOptions: TreeOptionData[]; onFilter: (filter: string | ((node: TreeOptionData, panelIndex: number) => boolean)) => void }>"
  },
  {
    "id": 1778746356,
    "platform_framework": [
      "Vue(PC)",
      "React(PC)"
    ],
    "component": "Cascader",
    "field_category": "Props",
    "field_name": "columnHeader",
    "field_type": [
      "String",
      "TNode"
    ],
    "field_desc_zh": "每一列的顶部自定义内容。`panelIndex` 表示当前列索引，`options` 表示当前列原始选项，`filteredOptions` 表示当前列过滤后的选项（未过滤时与 options 相同），`onFilter` 用于过滤当前列选项（传入字符串时内置大小写不敏感匹配；如需自定义匹配逻辑请传入过滤函数）。当内置搜索（filterable）有输入时，面板切换为扁平模式，`onFilter` 为空操作。",
    "field_desc_en": "Custom content at the top of each column. `panelIndex` indicates the current column index, `options` is the original option list, `filteredOptions` is the filtered option list (same as `options` when no filter is applied), `onFilter` is used to filter the current column options (built-in case-insensitive matching for strings; pass a filter function for custom matching). When the built-in search (filterable) has input, the panel switches to flat mode and `onFilter` becomes a noop",
    "custom_field_type": "TNode<{ panelIndex: number; options: TreeOptionData[]; filteredOptions: TreeOptionData[]; onFilter: (filter: string | ((node: TreeOptionData, panelIndex: number) => boolean)) => void }>"
  },
